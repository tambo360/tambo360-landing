---
import { site } from "../../config/site";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import LaunchSwitch from "../ui/LaunchSwitch.astro";
import Section from "../ui/Section.astro";

// B2: the brand green surface, never dark, so it does not merge with the dark footer that follows (u38).
// Heading on the left, the action on the right; the button goes verde-900 on the green.
// title/lead are the pre-launch copy; launchedTitle/launchedLead replace them from the launch date.
type Props = {
    title?: string;
    lead?: string;
    launchedTitle?: string;
    launchedLead?: string;
};

const {
    title = "Tu tambo merece algo mejor que un cuaderno mojado",
    lead = "Buscamos 3 tambos fundadores para el piloto. Anotarte lleva un minuto.",
    launchedTitle = title,
    launchedLead = "Registrate gratis hoy, no tardás más de 5 minutos.",
} = Astro.props;
---

<Section tone="brand" aria-labelledby="cierre-titulo">
    <div class="grid items-center gap-8 lg:grid-cols-[1.3fr_0.7fr] lg:gap-12">
        <div>
            <h2
                id="cierre-titulo"
                class="text-3xl leading-tight font-extrabold tracking-tight text-verde-900 sm:text-display-lg"
            >
                {
                    title === launchedTitle ? (
                        title
                    ) : (
                        <LaunchSwitch as="span">
                            <Fragment slot="before">{title}</Fragment>
                            <Fragment slot="after">{launchedTitle}</Fragment>
                        </LaunchSwitch>
                    )
                }
            </h2>
            <p class="mt-4 max-w-xl text-lg">
                <LaunchSwitch as="span">
                    <Fragment slot="before">{lead}</Fragment>
                    <Fragment slot="after">{launchedLead}</Fragment>
                </LaunchSwitch>
            </p>
        </div>
        <div class="flex lg:justify-end">
            <LaunchSwitch>
                <Button slot="before" href="/#sumate" size="lg" variant="dark">
                    Sumarme al piloto gratis
                    <Icon name="arrow-right" size={20} />
                </Button>
                {
                    site.registerUrl && (
                        <Button slot="after" href={site.registerUrl} size="lg" variant="dark" external>
                            Registrarme gratis
                            <Icon name="arrow-right" size={20} />
                        </Button>
                    )
                }
            </LaunchSwitch>
        </div>
    </div>
</Section>
