---
import { site } from "../../config/site";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import Section from "../ui/Section.astro";

type Props = { title?: string; lead?: string; href?: string };

const now = new Date();
const canShowRegisterSection = now >= site.productionDate ? true : false;

const {
    title = "Tu tambo merece algo mejor que un cuaderno mojado",
    lead = canShowRegisterSection ? "Registrate gratis hoy, no tardás mas de 5 minutos"
        : "Buscamos 3 tambos fundadores para el piloto. Anotarte lleva un minuto.",
    href = canShowRegisterSection ? "https://tambo360.vercel.app/iniciar-sesion"
        : "/#sumate",
} = Astro.props;
---

{
    canShowRegisterSection ? (
        <Section
            tone="dark"
            containerSize="md"
            aria-labelledby="cierre-titulo"
            class="text-center"
        >
            <h2
                id="cierre-titulo"
                class="text-3xl leading-tight font-extrabold tracking-tight text-white sm:text-display-lg"
            >
                {title}
            </h2>
            <p class="mx-auto mt-5 max-w-xl text-lg text-white/85">{lead}</p>
            <div class="mt-8 flex justify-center">
                <Button
                    href={href}
                    {...(canShowRegisterSection && { target: "_blank" })}
                    size="lg"
                >
                    Registrarme gratis
                    <Icon name="arrow-right" size={20} />
                </Button>
            </div>
        </Section>
    ) : (
        <Section
            tone="dark"
            containerSize="md"
            aria-labelledby="cierre-titulo"
            class="text-center"
        >
            <h2
                id="cierre-titulo"
                class="text-3xl leading-tight font-extrabold tracking-tight text-white sm:text-display-lg"
            >
                {title}
            </h2>
            <p class="mx-auto mt-5 max-w-xl text-lg text-white/85">{lead}</p>
            <div class="mt-8 flex justify-center">
                <Button href={href} size="lg">
                    Sumarme al piloto gratis
                    <Icon name="arrow-right" size={20} />
                </Button>
            </div>
        </Section>
    )
}
