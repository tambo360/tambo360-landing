---
import { modules } from "../../../data/home";
import Icon from "../../ui/Icon.astro";
import Section from "../../ui/Section.astro";
import SectionHeading from "../../ui/SectionHeading.astro";
---

<Section tone="paper" id="que-podes-hacer" aria-labelledby="modulos-titulo">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:items-center">
        <SectionHeading
            id="modulos-titulo"
            title="Lo que podés hacer desde el primer día"
            lead="Lo que hoy está repartido entre el cuaderno, la planilla y la cabeza del encargado, junto."
        />
        <ul class="grid border-t border-borde-neutro sm:grid-cols-2">
            {
                modules.map((module) => (
                    <li class="flex items-center gap-4 border-b border-borde-neutro py-5 sm:pr-6">
                        <Icon name={module.icon} size={28} class="text-verde-enlace" />
                        <h3 class="text-lg font-bold">{module.title}</h3>
                    </li>
                ))
            }
        </ul>
    </div>
</Section>
