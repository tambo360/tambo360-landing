---
import { site } from '../../../config/site';
import { pilotBenefits } from '../../../data/home';
import Icon from '../../ui/Icon.astro';
import Section from '../../ui/Section.astro';
import SectionHeading from '../../ui/SectionHeading.astro';
import WaitlistForm from '../WaitlistForm.astro';
---

<Section tone="soft" id="sumate" aria-labelledby="sumate-titulo">
  <div class="grid items-start gap-12 lg:grid-cols-[1fr_1.05fr]">
    <div>
      <SectionHeading
        id="sumate-titulo"
        title="Sumate al piloto: 3 meses gratis y te acompañamos"
        lead={`Tambo360 sale el ${site.launchDateLabel}. Buscamos 3 tambos fundadores para arrancar el piloto; si llegás después, quedás primero en la lista de espera.`}
      />
      <ul class="mt-10 space-y-6">
        {
          pilotBenefits.map((benefit) => (
            <li class="flex gap-4">
              <span class="flex size-12 shrink-0 items-center justify-center rounded-md bg-verde-cta text-verde-900">
                <Icon name={benefit.icon} />
              </span>
              <div>
                <h3 class="text-lg font-bold">{benefit.title}</h3>
                <p class="mt-1 leading-relaxed">{benefit.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
    <WaitlistForm />
  </div>
</Section>
