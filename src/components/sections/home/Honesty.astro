---
import { honesty } from '../../../data/home';
import Section from '../../ui/Section.astro';
import SectionHeading from '../../ui/SectionHeading.astro';
---

<Section aria-labelledby="sin-vueltas-titulo">
  <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
    <SectionHeading
      id="sin-vueltas-titulo"
      title="Lo que tenés que saber antes de anotarte"
      lead="Preferimos que lo sepas ahora y no después."
    />
    <dl class="grid gap-x-8 gap-y-8 sm:grid-cols-2">
      {
        honesty.map((item) => (
          <div class="border-t-2 border-verde-cta pt-4">
            <dt class="text-lg font-bold text-tinta">{item.title}</dt>
            <dd class="mt-2 leading-relaxed">{item.body}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</Section>
