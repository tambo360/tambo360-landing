---
import vacas from "../../../assets/images/vacas-5.webp";
import { problems } from "../../../data/home";
import Picture from "../../ui/Picture.astro";
import Section from "../../ui/Section.astro";
import SectionHeading from "../../ui/SectionHeading.astro";
---

<Section tone="paper" aria-labelledby="problemas-titulo">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]">
        <div>
            <SectionHeading
                id="problemas-titulo"
                title="¿Te suena alguna de estas?"
                lead="Cuando el tambo crece, el cuaderno ya no alcanza. Y lo que no se anota, no se puede arreglar."
            />
            <!-- A notebook page: every line of text is leading-8 so it sits on the 2rem rules. -->
            <ol class="renglones mt-10 space-y-8 py-8">
                {
                    problems.map((problem, index) => (
                        <li class="grid grid-cols-[2.5rem_1fr] leading-8">
                            <span
                                class="pr-3 text-right text-lg font-extrabold text-verde-enlace"
                                aria-hidden="true"
                            >
                                {index + 1}.
                            </span>
                            <div class="pl-4">
                                <h3 class="text-lg leading-8 font-bold">
                                    {problem.title}
                                </h3>
                                <p class="leading-8">{problem.body}</p>
                            </div>
                        </li>
                    ))
                }
            </ol>
        </div>
        <div class="relative">
            <Picture
                src={vacas}
                alt="Vacas Holando comiendo en el comedero de un tambo"
                sizes="(min-width: 1024px) 45vw, 100vw"
                class="aspect-4/5 w-full rounded-xl object-cover"
            />
        </div>
    </div>
</Section>
