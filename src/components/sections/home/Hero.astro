---
import hero from "../../../assets/images/hero.webp";
import { site } from "../../../config/site";
import Badge from "../../ui/Badge.astro";
import Button from "../../ui/Button.astro";
import Container from "../../ui/Container.astro";
import Icon from "../../ui/Icon.astro";
import LaunchSwitch from "../../ui/LaunchSwitch.astro";
import Picture from "../../ui/Picture.astro";
---

<section
    class="sobre-oscuro relative overflow-hidden bg-verde-900 text-white"
    aria-labelledby="hero-titulo"
>
    <div
        class="relative aspect-16/10 w-full sm:aspect-16/8 lg:absolute lg:inset-0 lg:aspect-auto"
    >
        <Picture
            src={hero}
            alt="Productor tambero revisando Tambo360 en una tablet, en el galpón junto a sus vacas"
            sizes="100vw"
            widths={[640, 960, 1280, 1600]}
            priority
            class="size-full object-cover"
            pictureClass="block size-full"
        />
        <div
            class="absolute inset-0 hidden bg-[linear-gradient(90deg,rgba(18,28,18,0.92),rgba(18,28,18,0.75)_42%,rgba(18,28,18,0.08)_78%)] lg:block"
        >
        </div>
        <div
            class="absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-verde-900 to-transparent lg:hidden"
        >
        </div>
    </div>

    <Container
        class="relative py-10 sm:py-14 lg:flex lg:min-h-160 lg:py-24 lg:items-center"
    >
        <div class="max-w-xl motion-safe:animate-aparecer">
            <h1
                id="hero-titulo"
                class="mt-5 text-4xl leading-[1.08] font-extrabold tracking-tight text-white sm:text-5xl lg:text-[3.5rem]"
            >
                Todo tu tambo en el celular: <span class="text-verde-cta"
                    >ordeñe, rodeo y costos</span
                >
            </h1>
            <p class="mt-6 text-lg leading-relaxed text-white/90 sm:text-xl">
                Anotás en la fosa, aunque no haya señal, y lo ves ordenado desde
                la oficina.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <LaunchSwitch>
                    <Button slot="before" href="#sumate" size="lg">
                        Sumarme al piloto gratis
                        <Icon name="arrow-right" size={20} />
                    </Button>
                    <Button slot="after" href={site.registerUrl} size="lg" external>
                        Registrarme gratis
                        <Icon name="arrow-right" size={20} />
                    </Button>
                </LaunchSwitch>
                <Button
                    href={site.demoUrl}
                    variant="ghost-dark"
                    size="lg"
                    external>Ver demo</Button
                >
            </div>
            <ul
                class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-[15px] text-white/85"
            >
                <li class="flex items-center gap-2">
                    <Icon name="credit-card-off" size={18} class="text-verde-cta" />Sin
                    tarjeta
                </li>
                <li class="flex items-center gap-2">
                    <Icon name="brand-whatsapp" size={18} class="text-verde-cta" />Te
                    ayudamos por WhatsApp
                </li>
            </ul>
        </div>
    </Container>
</section>
