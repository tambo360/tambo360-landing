---
import engine from '../../../assets/images/tambo-engine.webp';
import { steps } from '../../../data/home';
import Picture from '../../ui/Picture.astro';
import Section from '../../ui/Section.astro';
import SectionHeading from '../../ui/SectionHeading.astro';
---

<Section id="como-funciona" aria-labelledby="como-funciona-titulo">
  <SectionHeading
    id="como-funciona-titulo"
    title="Anotás una vez y Tambo360 hace el resto"
    lead="Sin pasar del cuaderno a la planilla y de la planilla a la computadora. Lo que se anota en la fosa ya está en la oficina."
  />
  <div class="mt-12 grid items-start gap-12 lg:grid-cols-[1fr_1.15fr]">
    <!-- Steps read like notes in the margin: a large number on a line that ties them together. -->
    <ol class="relative space-y-10 before:absolute before:top-4 before:bottom-4 before:left-6 before:w-px before:bg-borde-neutro">
      {
        steps.map((step, index) => (
          <li class="relative grid grid-cols-[3rem_1fr] gap-5">
            <span class="relative bg-white py-1 text-center text-5xl leading-none font-extrabold text-verde-enlace" aria-hidden="true">
              {index + 1}
            </span>
            <div>
              <h3 class="text-xl font-bold">{step.title}</h3>
              <p class="mt-2 leading-relaxed">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <figure class="rounded-xl border border-borde-verde bg-white p-3 sm:p-5">
      <Picture
        src={engine}
        alt="Pantalla de avisos de Tambo360: merma superior al promedio histórico, variación en la merma de un lote y merma por encima del rango esperado"
        sizes="(min-width: 1024px) 50vw, 100vw"
        widths={[480, 768, 1080, 1400]}
        class="w-full rounded-lg border border-borde-verde"
      />
      <figcaption class="mt-3 px-1 text-[15px] text-texto">Así se ven los avisos cuando algo se sale de lo normal.</figcaption>
    </figure>
  </div>
</Section>
