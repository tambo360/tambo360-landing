---
import Container from "../../ui/Container.astro";
import Icon from "../../ui/Icon.astro";

// B2: the one dark band of the home. Only the titles of the three items, each with its icon (user's comment, 04/11).
const devices: { icon: string; title: string }[] = [
    { icon: "device-desktop", title: "Podés usarlo desde cualquier dispositivo" },
    { icon: "wifi-off", title: "No necesitás conexión a internet" },
    { icon: "clipboard-list", title: "Organizá tus papeles" },
];
---

<section
    id="sin-senal"
    aria-labelledby="sin-senal-titulo"
    class="sobre-oscuro bg-verde-900 py-18 text-white/86 lg:py-24"
>
    <Container>
        <div class="grid gap-5 lg:grid-cols-2 lg:items-end lg:gap-18">
            <h2
                id="sin-senal-titulo"
                class="text-3xl leading-tight font-extrabold tracking-tight text-white sm:text-display-lg"
            >
                En la fosa no hay señal. Igual queda anotado
            </h2>
            <p class="text-bajada leading-bajada">
                Tambo360 guarda todo en el celular y lo manda solo cuando vuelve
                la conexión.
            </p>
        </div>
        <ul
            class="mt-8 grid border-y border-white/15 lg:mt-14 lg:grid-cols-3"
        >
            {
                devices.map((device) => (
                    <li class="flex items-center gap-4.5 py-5 not-first:border-t not-first:border-white/15 lg:px-7 lg:py-8 lg:first:pl-0 lg:not-first:border-t-0 lg:not-first:border-l">
                        <span class="grid size-13 shrink-0 place-items-center rounded-[14px] bg-verde-cta/14 text-verde-cta">
                            <Icon name={device.icon} size={28} />
                        </span>
                        <span class="text-lg leading-snug font-bold text-white">
                            {device.title}
                        </span>
                    </li>
                ))
            }
        </ul>
    </Container>
</section>
