---
import vaca from "../../../assets/images/vacas-2.webp";
import Picture from "../../ui/Picture.astro";
import Section from "../../ui/Section.astro";
---

<!-- B2: the reason Tambo360 exists, after the product. No box: the figure is a quote with a verde-cta bar. -->
<Section tone="paper" aria-labelledby="historia-titulo">
    <div class="grid items-center gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-18">
        <Picture
            src={vaca}
            alt="Una vaca Holando sola en el campo"
            sizes="(min-width: 1024px) 40vw, 100vw"
            class="aspect-[4/3] w-full rounded-xl object-cover object-[20%_center] lg:aspect-[4/5]"
        />
        <div>
            <p class="text-[15px] font-bold text-verde-enlace">
                Así nació Tambo360
            </p>
            <h2
                id="historia-titulo"
                class="mt-3 text-3xl leading-tight font-extrabold tracking-tight sm:text-display-lg"
            >
                La vaca con mastitis se ordeña última. La leche se tira. Y nadie
                lo anota.
            </h2>
            <p class="mt-5 max-w-[34em] text-lg leading-relaxed">
                El dueño se entera de palabra, días después. Esa leche nunca
                entra en ninguna cuenta: no se registra y su costo no se calcula
                jamás.
            </p>
            <figure class="mt-9 border-l-4 border-verde-cta py-1 pl-6">
                <p
                    class="text-2xl leading-tight font-extrabold tracking-tight text-tinta sm:text-[1.875rem]"
                >
                    <span class="text-verde-enlace">Hasta 40 litros</span> por día,
                    que no figuran en ningún lado
                </p>
                <figcaption class="mt-3 max-w-[34em] leading-relaxed">
                    Lo escuchamos de Ramón, encargado de un tambo quesero en
                    Corrientes, y de Manuel, con 300 vacas en Entre Ríos.
                    Tambo360 nació para que esa leche se cuente.
                </figcaption>
            </figure>
        </div>
    </div>
</Section>
