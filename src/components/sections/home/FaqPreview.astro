---
import { faqs, homeFaqIds } from '../../../data/faq';
import Accordion from '../../ui/Accordion.astro';
import Icon from '../../ui/Icon.astro';
import Section from '../../ui/Section.astro';
import SectionHeading from '../../ui/SectionHeading.astro';

const selected = homeFaqIds.map((id) => faqs.find((faq) => faq.id === id)).filter((faq) => faq !== undefined);
---

<Section tone="softer" aria-labelledby="dudas-titulo">
  <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <SectionHeading id="dudas-titulo" title="Las dudas más frecuentes" lead="Lo que más nos preguntan los productores antes de anotarse." />
      <a
        href="/preguntas-frecuentes"
        class="mt-6 inline-flex min-h-11 items-center gap-2 font-semibold text-verde-enlace underline-offset-4 hover:underline"
      >
        Ver todas las preguntas
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
    <div>
      {selected.map((faq) => <Accordion id={`dudas-${faq.id}`} question={faq.question} answer={faq.answer} />)}
    </div>
  </div>
</Section>
