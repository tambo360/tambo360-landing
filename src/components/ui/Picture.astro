---
import type { ImageMetadata } from 'astro';
import { Picture as AstroPicture } from 'astro:assets';

type Props = {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes: string;
  priority?: boolean;
  class?: string;
  pictureClass?: string;
};

const { src, alt, widths = [480, 768, 1080, 1440], sizes, priority = false, class: className, pictureClass } = Astro.props;
const usableWidths = widths.filter((width) => width <= src.width);
---

<AstroPicture
  src={src}
  alt={alt}
  widths={usableWidths.length ? usableWidths : [src.width]}
  sizes={sizes}
  formats={['avif', 'webp']}
  quality={72}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  class={className}
  pictureAttributes={{ class: pictureClass }}
/>
