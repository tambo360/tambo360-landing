---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'div'> & { size?: 'md' | 'lg' };
const { size = 'lg', class: className, ...rest } = Astro.props;
---

<div class:list={['mx-auto w-full px-4 sm:px-6 lg:px-8', size === 'lg' ? 'max-w-6xl' : 'max-w-3xl', className]} {...rest}>
  <slot />
</div>
