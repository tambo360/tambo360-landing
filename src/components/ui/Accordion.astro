---
import Icon from './Icon.astro';
import LaunchSwitch from './LaunchSwitch.astro';

type Props = { id: string; question: string; answer: string; launchedAnswer?: string; headingLevel?: 'h2' | 'h3' };
const { id, question, answer, launchedAnswer, headingLevel: Heading = 'h3' } = Astro.props;
---

<details id={id} class="group border-b border-borde-verde py-1 [&_summary::-webkit-details-marker]:hidden">
  <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 rounded-md py-3 text-left">
    <Heading class="text-lg leading-snug font-semibold text-tinta">{question}</Heading>
    <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-verde-050 text-verde-enlace transition-transform group-open:rotate-180">
      <Icon name="chevron-down" size={20} />
    </span>
  </summary>
  {
    launchedAnswer ? (
      <LaunchSwitch>
        <div slot="before" class="prosa pr-12 pb-5" set:html={`<p>${answer}</p>`} />
        <div slot="after" class="prosa pr-12 pb-5" set:html={`<p>${launchedAnswer}</p>`} />
      </LaunchSwitch>
    ) : (
      <div class="prosa pr-12 pb-5" set:html={`<p>${answer}</p>`} />
    )
  }
</details>
