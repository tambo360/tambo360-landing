---
import { nav, site, whatsappUrl } from '../../config/site';
import Container from '../ui/Container.astro';
import Icon, { type IconName } from '../ui/Icon.astro';
import LaunchSwitch from '../ui/LaunchSwitch.astro';
import Brand from './Brand.astro';

const socials: { href: string; label: string; icon: IconName }[] = [
  { href: site.social.instagram, label: 'Instagram', icon: 'brand-instagram' },
  { href: site.social.facebook, label: 'Facebook', icon: 'brand-facebook' },
  { href: site.social.linkedin, label: 'LinkedIn', icon: 'brand-linkedin' },
  { href: site.social.tiktok, label: 'TikTok', icon: 'brand-tiktok' },
];

const whatsapp = whatsappUrl();
const year = new Date().getFullYear();
const linkClass = 'inline-flex min-h-11 items-center text-white/85 transition-colors hover:text-verde-cta';
---

<footer class="sobre-oscuro bg-verde-950 text-white/85">
  <Container class="grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="max-w-sm">
      <Brand tone="dark" />
      <p class="mt-4 text-[15px] leading-relaxed">
        Registrás el ordeñe, controlás el rodeo y ordenás los costos desde un solo lugar. Hecho para tambos chicos y
        medianos de Argentina.
      </p>
      <ul class="mt-5 flex gap-1" aria-label="Redes sociales">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex size-11 items-center justify-center rounded-md text-white/85 transition-colors hover:bg-white/10 hover:text-verde-cta"
              >
                <Icon name={social.icon} size={22} />
                <span class="sr-only">{social.label} de Tambo360 (se abre en otra pestaña)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav aria-label="Pie de página">
      <h2 class="text-sm font-bold tracking-wide text-white">Tambo360</h2>
      <ul class="mt-3">
        {nav.map((item) => <li><a href={item.href} class={linkClass}>{item.label}</a></li>)}
        <li>
          <LaunchSwitch as="span">
            <a slot="before" href="/#sumate" class={linkClass}>Sumarme al piloto</a>
            <a slot="after" href={site.registerUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
              Registrarme<span class="sr-only"> (se abre en otra pestaña)</span>
            </a>
          </LaunchSwitch>
        </li>
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-bold tracking-wide text-white">Contacto</h2>
      <ul class="mt-3">
        <li>
          <a href={`mailto:${site.email}`} class:list={[linkClass, 'gap-2']}><Icon name="mail" size={18} />{site.email}</a>
        </li>
        {
          whatsapp && (
            <li>
              <a href={whatsapp} target="_blank" rel="noopener noreferrer" class:list={[linkClass, 'gap-2']}>
                <Icon name="brand-whatsapp" size={18} />
                WhatsApp, las 24 horas
              </a>
            </li>
          )
        }
        <li><a href="/privacidad" class={linkClass}>Política de privacidad</a></li>
        <li><a href="/terminos" class={linkClass}>Términos y condiciones</a></li>
      </ul>
    </div>
  </Container>
  <div class="border-t border-white/10">
    <Container class="py-5 text-sm text-white/70">
      <p>© {year} Tambo360</p>
    </Container>
  </div>
</footer>
