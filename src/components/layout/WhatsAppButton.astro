---
import { whatsappUrl } from '../../config/site';
import Icon from '../ui/Icon.astro';

const href = whatsappUrl();
---

{
  href && (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="group fixed right-2 bottom-2 z-50 inline-flex size-12 items-center justify-center gap-2 rounded-full bg-whatsapp font-semibold text-verde-900 shadow-lg ring-2 ring-verde-900/10 transition-transform hover:-translate-y-0.5 sm:right-6 sm:bottom-6 sm:size-auto sm:min-h-14 sm:justify-start sm:py-3 sm:pr-5 sm:pl-4"
      data-whatsapp-float
    >
      <Icon name="brand-whatsapp" size={24} class="sm:size-[26px]" />
      <span class="hidden sm:inline" aria-hidden="true">Escribinos</span>
      <span class="sr-only">Escribinos por WhatsApp (se abre en otra pestaña)</span>
    </a>
  )
}
