---
import { whatsappUrl } from '../../config/site';
import Icon from '../ui/Icon.astro';

const href = whatsappUrl();
---

{
  href && (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="group fixed right-4 bottom-4 z-50 inline-flex min-h-14 items-center gap-2 rounded-full bg-whatsapp py-3 pr-5 pl-4 font-semibold text-verde-900 shadow-lg ring-2 ring-verde-900/10 transition-transform hover:-translate-y-0.5 sm:right-6 sm:bottom-6"
      data-whatsapp-float
    >
      <Icon name="brand-whatsapp" size={26} />
      <span class="hidden sm:inline" aria-hidden="true">Escribinos</span>
      <span class="sr-only">Escribinos por WhatsApp (se abre en otra pestaña)</span>
    </a>
  )
}
