---
import ClosingCta from '../components/sections/ClosingCta.astro';
import Accordion from '../components/ui/Accordion.astro';
import Container from '../components/ui/Container.astro';
import Icon from '../components/ui/Icon.astro';
import LaunchSwitch from '../components/ui/LaunchSwitch.astro';
import { isLaunched, site, whatsappUrl } from '../config/site';
import { faqs } from '../data/faq';
import BaseLayout from '../layouts/BaseLayout.astro';

const stripHtml = (html: string) => html.replace(/<[^>]+>/g, '');
// JSON-LD is fixed at build time: a build from the launch date on carries the launched answers.
const launched = isLaunched();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: stripHtml((launched && faq.launchedAnswer) || faq.answer) },
  })),
};

const whatsapp = whatsappUrl('Hola, tengo una pregunta sobre Tambo360.');
---

<BaseLayout
  title="Preguntas frecuentes"
  description="Si funciona sin señal, cuánto tiempo lleva por día, cuánto cuesta y quién ve los datos de tu tambo: las respuestas a lo que más nos preguntan los productores."
  jsonLd={jsonLd}
>
  <section class="bg-verde-025 py-14 sm:py-20" aria-labelledby="faq-titulo">
    <Container size="md">
      <h1 id="faq-titulo" class="text-4xl font-extrabold tracking-tight sm:text-display-xl">Preguntas frecuentes</h1>
      <p class="mt-5 max-w-2xl text-lg">
        Lo que más nos preguntan los productores antes de{' '}
        <LaunchSwitch as="span">
          <Fragment slot="before">anotarse al piloto</Fragment>
          <Fragment slot="after">empezar</Fragment>
        </LaunchSwitch>. Si tu duda no está,{' '}
        {whatsapp ? <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="font-semibold text-verde-enlace underline underline-offset-2">escribinos por WhatsApp</a> : <a href={`mailto:${site.email}`} class="font-semibold text-verde-enlace underline underline-offset-2">escribinos a {site.email}</a>}.
      </p>
    </Container>
  </section>

  <section class="py-12 sm:py-16" aria-label="Respuestas">
    <Container size="md">
      <nav aria-label="Ir a una pregunta" class="mb-10 rounded-lg border border-borde-verde bg-gris-025 p-5">
        <h2 class="text-sm font-bold text-tinta">Ir directo a</h2>
        <ul class="mt-3 grid gap-x-6 gap-y-1 sm:grid-cols-2">
          {
            faqs.map((faq) => (
              <li>
                <a href={`#${faq.id}`} class="inline-flex min-h-10 items-start gap-1.5 py-1.5 text-[15px] text-verde-enlace hover:underline" data-faq-link>
                  <Icon name="arrow-right" size={16} class="mt-1" />
                  {faq.question}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      {faqs.map((faq) => <Accordion id={faq.id} question={faq.question} answer={faq.answer} launchedAnswer={faq.launchedAnswer} headingLevel="h2" />)}
    </Container>
  </section>

  <ClosingCta
    title="¿Te quedó alguna duda? Probalo 3 meses gratis"
    lead="En el piloto te acompañamos 1 a 1 por WhatsApp para configurar tu tambo."
    launchedTitle="¿Te quedó alguna duda? Probalo 30 días gratis"
    launchedLead="Registrate y, si te trabás, nos escribís por WhatsApp."
  />
</BaseLayout>

<script>
  // Opening the answer the link points to, also when someone lands on /preguntas-frecuentes#sin-senal.
  const openFromHash = () => {
    const target = location.hash && document.getElementById(location.hash.slice(1));
    if (target instanceof HTMLDetailsElement) target.open = true;
  };
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
</script>
