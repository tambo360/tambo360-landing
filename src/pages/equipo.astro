---
import { Image } from 'astro:assets';
import ClosingCta from '../components/sections/ClosingCta.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Icon from '../components/ui/Icon.astro';
import { site } from '../config/site';
import { problems } from '../data/home';
import { team } from '../data/team';
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `Equipo de ${site.name}`,
  inLanguage: site.lang,
  about: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
    member: team.map((member) => ({ '@type': 'Person', name: member.name })),
  },
};
---

<BaseLayout
  title="Conocé al equipo"
  description={`Las personas que hacen ${site.name}: un equipo de desarrollo dedicado al campo que recorrió tambos y escuchó a quienes los trabajan antes de escribir una línea.`}
  jsonLd={jsonLd}
>
  <section class="bg-papel py-14 sm:py-20" aria-labelledby="equipo-titulo">
    <Container>
      <h1 id="equipo-titulo" class="max-w-3xl text-4xl font-extrabold tracking-tight sm:text-display-xl">
        Conocé al equipo que conforma {site.name}
      </h1>
      <p class="mt-5 max-w-2xl text-lg">
        No venimos del tambo. Por eso fuimos a buscarlo. Somos un equipo de desarrollo dedicado al campo: antes de escribir una
        línea, recorrimos tambos y escuchamos a quienes los trabajan, para llevar algo simple a problemas reales.
      </p>
    </Container>
  </section>

  <Section aria-label="Integrantes del equipo">
    <ul class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
      {
        team.map((member) => (
          <li class="text-center">
            <Image
              src={member.photo}
              alt=""
              width={200}
              height={200}
              densities={[1, 2]}
              class="mx-auto aspect-square w-full max-w-44 rounded-full object-cover ring-4 ring-verde-050 grayscale"
            />
            <p class="mt-3 text-lg leading-tight font-semibold text-tinta">{member.name}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Proof of the fieldwork (Q-51 a): only existing material, the story of Q-13 and the home problems.
       Dark so the page alternates paper, white, dark and the paper closing (Regla del Corte). -->
  <Section tone="dark" aria-labelledby="campo-titulo">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
      <div>
        <h2 id="campo-titulo" class="text-3xl leading-tight font-extrabold tracking-tight text-white sm:text-display-lg">
          Lo que escuchamos en los tambos
        </h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed">
          Ramón, encargado de un tambo quesero en Corrientes, y Manuel, con 300 vacas en Entre Ríos, nos contaron lo
          mismo: hasta 40 litros por día que no figuran en ningún lado. De ahí salió {site.name}.
        </p>
        <a href="/#como-funciona" class="mt-6 inline-flex min-h-11 items-center gap-2 font-semibold text-white underline underline-offset-4 hover:decoration-2">
          Ver cómo funciona
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
      <ul class="border-t border-white/20">
        {
          problems.map((problem) => (
            <li class="border-b border-white/20 py-6">
              <h3 class="text-lg font-bold text-white">{problem.title}</h3>
              <p class="mt-1 leading-relaxed">{problem.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <ClosingCta />
</BaseLayout>
